# Copy this file to .env.local and fill in your own Firebase project's
# config (Firebase console → Project settings → General → Your apps →
# SDK setup and configuration → Config). .env.local is gitignored, so your
# keys never get committed.
#
# Leave this file as-is / delete .env.local and the app runs fine with no
# account features — everything just stays in local storage.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
